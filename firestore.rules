rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /customers/{uid} {
      allow read: if request.auth.uid == uid;

      match /checkout_sessions/{id} {
        allow read, write: if request.auth.uid == uid;
      }
      match /subscriptions/{id} {
        allow read: if request.auth.uid == uid;
      }
      match /payments/{id} {
        allow read: if request.auth.uid == uid;
      }
    }
    
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
			}
      
    match /partners/{id} {
      	allow read: if true
      	}
    
    match /stages/{id} {
      	allow read: if true
      	}

    match /batch/{id} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
			}
    match /batch_steps/{stepId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /batch_types/{id} {
      allow read: if true;
    }
    
    match /batch_step_instances/{instanceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    match /batch_step_images/{imageId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /batch/{batchId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    match /supply/{id} {
      allow read, write: if true;
    }

    match /orders/{id} {
      allow read, write: if true;
    }

    match /stock/{id} {
      allow read, write: if true;
    }

    match /stock_history/{id} {
      allow read, write: if true;
    }

    match /sales/{id} {
      allow read, write: if true;
    }

    match /payouts/{id} {
      allow read, write: if true;
    }

    match /stock_types/{id} {
      allow read, write: if true;
    }

    match /stock_alerts/{id} {
      allow read, write: if true;
    }

    match /products/{id} {
      allow read: if true;

      match /prices/{id} {
        allow read: if true;
      }

      match /tax_rates/{id} {
        allow read: if true;
      }
    }
  }
}
