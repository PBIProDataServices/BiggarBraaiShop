# Uncomment this line to define a global platform for your project
platform :ios, '16.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  
  # Workaround for build issues with firebase_storage
  pod 'FirebaseFirestore', :git => 'https://github.com/invertase/firestore-ios-sdk-frameworks.git', :tag => '10.25.0'
  
  # Add Firebase Storage explicitly with modular headers
  pod 'FirebaseStorage', '10.25.0', :modular_headers => true
  pod 'FirebaseCore', '10.25.0', :modular_headers => true
  pod 'FirebaseAuth', '10.25.0', :modular_headers => true
  
  # Add Google Sign-In dependencies with specific versions
  pod 'GoogleSignIn', '7.1.0', :modular_headers => true
  pod 'GTMSessionFetcher', '3.5.0', :modular_headers => true
  # Updated GoogleUtilities to support mobile_scanner requirements
  pod 'GoogleUtilities', '~> 7.13.0', :modular_headers => true
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # Begin additional post-installation settings
    target.build_configurations.each do |config|
      # Ensure minimum deployment target is set correctly
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      
      # Add arm64 to excluded architectures for simulators
      if config.build_settings['PLATFORM_NAME'] == 'iphonesimulator'
        config.build_settings["EXCLUDED_ARCHS[sdk=iphonesimulator*]"] = "arm64"
      end
      
      # Enable library evolution
      config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
      
      # Add additional required flags
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1'
      ]
      
      # Fix for Firebase Storage module issue
      config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
      config.build_settings['DEFINES_MODULE'] = 'YES'
      
      # Additional settings for Firebase
      config.build_settings['ENABLE_BITCODE'] = 'NO'
      
      # Additional settings for iOS
      config.build_settings['SWIFT_VERSION'] = '5.0'
      config.build_settings['VALIDATE_WORKSPACE'] = 'YES'
      
      # Fix for Xcode 15+ warnings
      config.build_settings['GCC_WARN_64_TO_32_BIT_CONVERSION'] = 'NO'
      config.build_settings['CLANG_WARN_QUOTED_INCLUDE_IN_FRAMEWORK_HEADER'] = 'NO'
      config.build_settings['ENABLE_USER_SCRIPT_SANDBOXING'] = 'NO'
      
      # Fix for Firebase module issues
      if target.name.start_with?('Firebase')
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['DEFINES_MODULE'] = 'YES'
      end
      
      # Fix for Google Sign-In module issues
      if target.name.start_with?('GoogleSignIn') || target.name.start_with?('GTMSessionFetcher')
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        config.build_settings['CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES'] = 'YES'
        config.build_settings['DEFINES_MODULE'] = 'YES'
      end
    end
  end
end
